# Smart Vending Machine Store — copy this file to ".env" and edit as needed.
# All values are optional; the defaults below are what the app uses.

PORT=3000

# ---------------------------------------------------------------------------
# Database — SQLite (default) or PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# DATABASE_URL takes precedence over DB_PATH. With neither set the app uses
# the local SQLite file and creates it (plus the 12-product catalogue) on
# first start. Setting DATABASE_URL switches to PostgreSQL; the schema and
# seed are created there automatically too.

# DB_PATH=./data/vending.db

# Supabase dashboard → Project Settings → Database → Connection string (URI):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=
# SUPABASE_DB_URL=    # optional alias, used only when DATABASE_URL is unset

# TLS (auto-detected: SSL for remote hosts, plain for localhost).
# DB_SSL=true | false | no-verify

# Connection pool size (default 10).
# DB_POOL_MAX=10

# Admin login. When ADMIN_PASSWORD is set it is re-applied on every start.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ChangeMe123!

# Secret for signing admin tokens (set a long random string in production).
# SESSION_SECRET=replace-with-a-long-random-string

# ADMIN_TOKEN_TTL_MS=28800000
# SESSION_TTL_MS=3600000
# DISPENSE_LOCK_MS=1200
